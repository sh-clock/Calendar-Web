{
  "name": "calendar-web",
  "version": "1.0.0",
  "description": "End-to-end-encrypted calendar PoC — Cloudflare Worker + Durable Object (protocol v4.1 + v4.2 calendar delta) with a static GitHub Pages client.",
  "type": "module",
  "private": true,
  "scripts": {
    "test:unit": "node test/core-unit.mjs",
    "test:local": "node test/run-local.mjs",
    "test:remote": "node test/api-suite.mjs",
    "dev:worker": "cd worker && npx wrangler dev --test-scheduled",
    "deploy": "cd worker && npx wrangler deploy",
    "bootstrap": "node cli/bootstrap.mjs"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
